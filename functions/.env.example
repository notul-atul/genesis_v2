# Non-secret function params (loaded by the Firebase CLI from functions/.env at deploy
# and by the emulator). Copy to functions/.env. Use functions/.env.local to override
# values for the emulator only.

# HighLevel marketplace app (Settings -> Advanced -> Auth in the developer portal)
HL_CLIENT_ID=
# Optional: some marketplace apps require the app version id on the install URL
HL_APP_VERSION_ID=
# Must exactly match a redirect URI registered on the HighLevel app.
# Production goes through the Hosting rewrite so the URL is stable:
HL_REDIRECT_URI=https://genesis-v2-b77b9.web.app/api/oauth/callback

# Where the Vue app lives (used for post-OAuth redirects and CORS)
APP_URL=https://genesis-v2-b77b9.web.app
# Comma separated extra origins allowed to call the API (local dev)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM
LLM_MODEL=gpt-5.5
LLM_EFFORT=low

# Named Firestore database (this project has no "(default)" database)
FIRESTORE_DATABASE_ID=genesis-v2

# Secrets are NOT set here. In production use Secret Manager:
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set HL_CLIENT_SECRET
#   firebase functions:secrets:set APP_SECRET        (any random 32+ byte string)
# For the emulator put them in functions/.secret.local (git-ignored), see .secret.local.example
