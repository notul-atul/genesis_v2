# Firebase web config (Project settings -> Your apps). These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=genesis-v2-b77b9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=genesis-v2-b77b9
VITE_FIREBASE_STORAGE_BUCKET=genesis-v2-b77b9.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Named Firestore database
VITE_FIRESTORE_DATABASE_ID=genesis-v2

# Cloud Functions base URL (the `api` function). Called directly (not through the
# Hosting rewrite) so SSE responses are never buffered by the CDN.
VITE_API_BASE_URL=https://us-central1-genesis-v2-b77b9.cloudfunctions.net/api

# Local development against the Firebase emulators
VITE_USE_EMULATORS=false
# VITE_API_BASE_URL=http://127.0.0.1:5001/genesis-v2-b77b9/us-central1/api
