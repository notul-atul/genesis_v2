# ─────────────────────────────────────────────────────────────────────────────
# Genesis: every environment variable, in one place.
# Real values live in (all git-ignored):
#   functions/.env           non-secret function params (deploy + emulator)
#   functions/.env.local     emulator-only overrides
#   functions/.secret.local  secrets for the emulator
#   frontend/.env            Vite build-time config
# Production secrets go in Google Secret Manager via `firebase functions:secrets:set`.
# No Firebase service-account key is needed: Cloud Functions use their runtime
# service account (Application Default Credentials).
# ─────────────────────────────────────────────────────────────────────────────

# ---- functions/.env ----------------------------------------------------------
HL_CLIENT_ID=                       # HighLevel marketplace app Client ID
HL_APP_VERSION_ID=                  # optional, only if your app's install URL needs version_id
HL_REDIRECT_URI=https://genesis-v2-b77b9.web.app/api/oauth/callback
APP_URL=https://genesis-v2-b77b9.web.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_MODEL=gpt-5.5
LLM_EFFORT=low                      # low | medium | high (higher = slower first token)
FIRESTORE_DATABASE_ID=genesis-v2

# ---- Secrets (Secret Manager in prod, functions/.secret.local in the emulator)
OPENAI_API_KEY=
HL_CLIENT_SECRET=
APP_SECRET=                         # openssl rand -base64 48 (signs preview tokens, encrypts HL tokens at rest)

# ---- frontend/.env (public Firebase web config, not secrets) ----------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=genesis-v2-b77b9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=genesis-v2-b77b9
VITE_FIREBASE_STORAGE_BUCKET=genesis-v2-b77b9.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=genesis-v2
VITE_API_BASE_URL=https://us-central1-genesis-v2-b77b9.cloudfunctions.net/api
VITE_USE_EMULATORS=false
